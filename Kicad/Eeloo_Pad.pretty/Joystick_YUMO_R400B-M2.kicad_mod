(footprint "Joystick_YUMO_R400B-M2"
	(version 20241229)
	(generator "pcbnew")
	(layer "F.Cu")
	(descr "YUMO/QS R300B/R400B 3-axis 5k joystick (Electrokit 41013265, Micros PRZ R400B-M2). PCB used as mounting panel: Ø41 cutout + 4x M2 at 32.5 mm. Body 40.4x40.4x25.5 under the PCB, pots protrude on 2 sides.")
	(tags "joystick 3-axis YUMO R400B")
	(property "Reference" "JS**" (at 0 -27.5 0) (layer "F.SilkS") (effects (font (size 1.2 1.2) (thickness 0.15))))
	(property "Value" "R400B-M2" (at 0 27.5 0) (layer "F.Fab") (effects (font (size 1.2 1.2) (thickness 0.15))))
	(property "Datasheet" "https://www.micros.com.pl/mediaserver/info-prz%20r400b-m2.pdf" (at 0 0 0) (layer "F.Fab") (hide yes) (effects (font (size 1.27 1.27))))
	(property "Description" "3-axis joystick 5k 50deg with fire button" (at 0 0 0) (layer "F.Fab") (hide yes) (effects (font (size 1.27 1.27))))
	(attr exclude_from_pos_files exclude_from_bom)
	(fp_circle (center 0 0) (end 20.5 0) (stroke (width 0.1) (type solid)) (fill no) (layer "Edge.Cuts"))
	(fp_circle (center 0 0) (end 24.8 0) (stroke (width 0.15) (type solid)) (fill no) (layer "F.SilkS"))
	(fp_circle (center 0 0) (end 25.3 0) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(fp_rect (start -20.2 -20.2) (end 20.2 20.2) (stroke (width 0.1) (type solid)) (fill no) (layer "B.Fab"))
	(fp_rect (start -27.0 -21.0) (end 21.0 27.0) (stroke (width 0.05) (type solid)) (fill no) (layer "B.CrtYd"))
	(fp_text user "pot Y" (at -23.5 0 90) (layer "B.Fab") (effects (font (size 1 1) (thickness 0.12)) (justify mirror)))
	(fp_text user "pot X" (at 0 23.5 0) (layer "B.Fab") (effects (font (size 1 1) (thickness 0.12)) (justify mirror)))
	(pad "" np_thru_hole circle (at -16.25 -16.25) (size 2.2 2.2) (drill 2.2) (layers "*.Cu" "*.Mask"))
	(pad "" np_thru_hole circle (at 16.25 -16.25) (size 2.2 2.2) (drill 2.2) (layers "*.Cu" "*.Mask"))
	(pad "" np_thru_hole circle (at -16.25 16.25) (size 2.2 2.2) (drill 2.2) (layers "*.Cu" "*.Mask"))
	(pad "" np_thru_hole circle (at 16.25 16.25) (size 2.2 2.2) (drill 2.2) (layers "*.Cu" "*.Mask"))
	(embedded_fonts no)
	(model "${KIPRJMOD}/STEP/Joystick_YUMO_R400B.wrl" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
