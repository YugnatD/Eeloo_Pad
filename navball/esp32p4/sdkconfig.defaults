CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
# This board answers as a 720x720 panel: with the 800x800 setting the panel drops ~80 columns
# in the middle of every line (image "cut in two"). Measured with a test card, see README.
CONFIG_BSP_LCD_TYPE_720_720_4_INCH=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
# chip revision: recent boards ship ESP32-P4 v3.x (use sdkconfig.defaults.rev1_3 for v1.x chips)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_SPEED=250
